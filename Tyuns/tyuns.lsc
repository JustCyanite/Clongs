syntax-cleanup:
 t͡ɕ => tɕ
 []$1 $1 => [+long] *

##Turn 76
Retroflex-collapse:
 [retroflex] => [alveolar]

h-Lenition:
 [dental fricative voiceless] => [glottal]

Creaky-stops:
 [+creaky] * => [-creaky] ʔ

##Turn 77 + 78
Uvular-collapse:
 [uvular] => [velar]

Tap-lost:
 ɾ => d

rhotic-velar:
 ɣ => ɹ

lateral2palatal-approx:
 ʎ => j

Plosive-affrication:
 [palatal stop] => [affricate]

##Turn 79
Palatalisation:
 {[alveolar stop], [velar stop]} j => [palatal affricate] *

lateral-simplification:
 ɬ => l

##Turn 80
Vowel-pushchain:
 {ɨ, i, e, a, o, u} => {ɪ, ɛ, ɛ, ɑ, ʊ, ʊ}

Lenition-pushchain:
 {k, s, x, h} => {x, h, h, *}
 {kʷ, sʷ, xʷ, hʷ} => {xʷ, hʷ, hʷ, w}

##Turn 81
Velar-fricatisation:
 ɡ => ɣ

z-rhoticisation:
 z => ɹ

##Turn 82
Dentalisation:
 {ɕ, ɕʷ} => {θ, θʷ}

td-lenition:
 [alveolar stop] => [fricative]

##Turn 83
Backed-vowels:
 {ɪ, ɛ} => {ʊ, ɑ}/{_ ʔ, ʔ _} 

Word-final-vowel-loss:
 [vowel -long] => */[vowel] [cons]? [cons]? [cons] _ $
 [vowel +long] => [-long]/_ $

##Turn 84
Glottal-lost:
 ʔ => *

Labial-lenition:
 [labial stop] => [fricative]
 [labiodental fricative] => [labial]

##Turn 85
Velar-rounding:
 {[+velarised], w, w j} [vowel] => {[-velarised], *, * j} [vowel rounded]
 then:
  w => ʊ
  [+velarised] * => [-velarised] ʊ
# {[+velarised], w} [vowel !cmid back] => * [vowel rounded] 

Rhotic-Velarisation:
 ɹ => ɰ

geminate-cleanup2:
 []$1 $1 => [+long] *

##Turn 86
h-gemination:
 [] h => [+long] *
 h => */$ _ [vowel]
 h [cons -long] => * [cons +long]/$ _

geminate-cleanup:
 []$1 $1 => [+long] *

re-plosiving:
 [+long fricative !alveolar] => [stop -long]

##Syllable syntaxing and defining
Syllabic-consonants:
 {[glide], [lateral], [nasal]} => [+syllabic]/{$, [cons !lateral !glide]} _ {$, [!lateral !glide cons]}

Syllables:
 explicit
 {[stop], [fricative], [affricate]}? {[stop], [fricative], [lateral], [nasal], [nasal] [nasal]}? {[vowel], [glide] [vowel], [vowel] [glide], [glide] [vowel] [glide], [+syllabic]} {[nasal], [fricative], l}? {[stop], [fricative], [affricate], [nasal]}?

Stress-markers:
 [+marked] => [-marked +stressed]

syllables:
 clear

##Turn 87
geminate-cleaup-again:
 [cons +long]$1 * => $1 $1
 . => *
 then:
  [cons +long] => [-long]

Nasal-Assimilation:
 [nasal] => [$place]/_ [obstruent $place]
 
Nasal-fortition:
 [nasal] [fricative !alveolar] => * [stop]
 [nasal] [fricative alveolar] => * [affricate]

##Turn 88
h-revival:
 * => h/$ _ {[vowel], j}

Syllables:
 clear

full-palatalisation:
 {[stop !labial], [labial stop]} {j, ɪ} => {[palatal affricate], [+palatalised]} */_ [vowel]
 {[fricative !glottal], h} {j, ɪ} => {[palatal], x} */_ [vowel]
 {[stop !labial], [labial stop]} ʏ => {[palatal affricate +velarised], [+palatalised +velarised]} */_ [vowel]
 {[fricative !glottal], h} ʏ => {[palatal +velarised], xʷ} */_ [vowel]

more-cleanup:
 [vowel]$1 $1 => [+long] *
 * => ə/{{$, [!vowel]} [cons *syllabic !glide !lateral]$1 _ [cons *syllabic !glide !lateral], [cons *syllabic !glide !lateral]$1 _ [cons *syllabic !glide !lateral] {$, [!vowel]}}//$1 _ $1
 then:
  {[glide], [lateral], [nasal]}$1 => [+syllabic]/{$, [cons !lateral !glide]} _ {$, [!lateral !glide cons]}//{$1 _, _ $1}
  {[glide], [lateral], [nasal]} => [-syllabic]/{{!$, [!cons]} _, _ {!$, [!cons]}}

Syllables:
 explicit
 {[cons !glide !lateral], @geminate}? {ɰ, l, j}? {[vowel], [+syllabic]} {ɰ, l, j}? [cons -velarised -palatalised !glide !lateral !glottal]?/$ _
 [cons !glide !lateral]? {ɰ, l, j}? {[vowel], [+syllabic]} {ɰ, l, j}? [cons -velarised -palatalised !glide !lateral !glottal]?/!$ _ !$
 [cons !glide !lateral]? {ɰ, l, j}? {[vowel], [+syllabic]} {l, ɰ, j}? {[cons -velarised -palatalised !glide !lateral !glottal], @geminate}?/_ $

new-stress:
 ([+long] [cons -syllabic]* => [+stressed]/_ $
  else: 
   [vowel] [cons -syllabic]* => [+stressed]/_ <syl> $
   else:
    [] => [+stressed]/$ _
  )
  then:
   <syl> => [+stressy]/_ <syl> [+stressed]

##Turn 89
unstressed-shortening:
