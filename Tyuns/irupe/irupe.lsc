Element geminate [cons]$1 $1
Element stressable {[vowel], [+syllabic]}

Syntax:
 {g, gʷ} => {ɡ, ɡʷ}
 {t͡s, d͡z, t͡ʃ, d͡ʒ, t͡ɕ, t͡ɕʷ, d͡ʑʷ} => {ts, dz, tʃ, dʒ, tɕ, tɕʷ, dʑ}
 []$1 $1 => [+long] *

Turn102:
{aː, eː, uː, iː} => {æː, iː, aw, aj}
{aã, eẽ, uũ, iĩ} => {æ̃ː, ĩː, ãw, ãj}
 then: {ãw̃, ãj̃} => {ãw, ãj}
 {d, ɾ, l} => {ɾ, l, l̞}

Turn103:
{t, s} => {d, z}/@stressable _ @stressable

Turn104:
l̞ => ɹ

Turn105:
[vowel +nasalised] => [-nasalised +grave]
