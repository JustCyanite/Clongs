Feature type(*cons, vowel)

Feature place(labial, labiodental, dental, alveolar, postalveolar, retroflex, prepalatal, palatal, uvular, velar, glottal)
Feature manner(stop, fricative, nasal, trill, tap, approximant, affricate)
Feature category(obstruent, sonorant)
Feature voice(voiced, voiceless)
Feature +lateral

Feature height(open, cmid, omid, closed)
Feature frontness(front, central, back)
Feature quality(lax, tense)
Feature roundness(rounded,unround)

Feature +prenasalised, +aspirated, +labialised, +palatalised, +creaky, +nasalised, +long, +acute, +grave, +ejective, +syllabic
Diacritic ⁿ (before) [+prenasalised]
Diacritic ʰ [+aspirated]
Diacritic ʷ [+labialised]
Diacritic ʲ [+palatalised]
Diacritic ˀ [+creaky]
Diacritic ̃ (floating) [+nasalised]
Diacritic ́  (floating) [+acute]
Diacritic ̀  (floating) [+grave]
Diacritic ʼ [+ejective]
Diacritic ̩ [+syllabic]
Diacritic ̯ [-syllabic]
Diacritic ː (floating) [+long] 

Symbol a [open central lax unround vowel]
Symbol ɶ [open central lax rounded vowel]
Symbol ɑ [open back tense unround vowel]
Symbol ɒ [open back tense rounded vowel]
Symbol ɛ [omid front tense unround vowel]
Symbol œ [omid front tense rounded vowel]
Symbol ə [omid central lax unround vowel]
Symbol ɞ [omid central lax rounded vowel]
Symbol ʌ [omid back lax unround vowel]
Symbol ɔ [omid back tense rounded vowel]
Symbol e [cmid front tense unround vowel]
Symbol ø [cmid front tense rounded vowel]
Symbol o [cmid back tense rounded vowel]
Symbol ʊ [cmid back lax rounded vowel]
Symbol i [closed front tense unround vowel]
Symbol y [closed front tense rounded vowel]
Symbol ɪ [closed front lax unround vowel]
Symbol ʏ [closed front lax rounded vowel]
Symbol ɨ [closed central tense unround vowel]
Symbol ʉ [closed central tense rounded vowel]
Symbol ɯ [closed back tense unround vowel]
Symbol u [closed back tense rounded vowel]

Symbol p [labial stop voiceless obstruent]
Symbol b [labial stop voiced obstruent]
Symbol m [labial nasal voiced sonorant]
Symbol ɸ [labial fricative voiceless obstruent]
Symbol β [labial fricative voiced obstruent]

Symbol f [labiodental fricative voiceless obstruent]
Symbol v [labiodental fricative voiced obstruent]

Symbol t̪ [dental stop voiceless obstruent]
Symbol d̪ [dental stop voiced obstruent]
Symbol n̪ [dental nasal voiced sonorant]
Symbol θ [dental fricative voiceless obstruent]
Symbol ð [dental fricative voiced obstruent]

Symbol t [alveolar stop voiceless obstruent]
Symbol d [alveolar stop voiced obstruent]
Symbol n [alveolar nasal voiced sonorant]
Symbol s [alveolar fricative voiceless obstruent]
Symbol z [alveolar fricative voiced obstruent]
Symbol ɬ [alveolar fricative voiceless obstruent +lateral]
Symbol ɮ [alveolar fricative voiced obstruent +lateral]
Symbol ɾ [alveolar tap voiced sonorant]
Symbol r [alveolar trill voiced sonorant]
Symbol ɹ [alveolar approximant voiced sonorant]
Symbol l [alveolar approximant voiced sonorant +lateral]
Symbol ts [alveolar affricate voiceless obstruent]
Symbol dz [alveolar affricate voiced obstruent]
Symbol tɬ [alveolar affricate voiceless obstruent +lateral]
Symbol dɮ [alveolar affricate voiced obstruent +lateral]

Symbol ʃ [postalveolar fricative voiceless obstruent]
Symbol ʒ [postalveolar fricative voiced obstruent]
Symbol tʃ [postalveolar affricate voiceless obstruent]
Symbol dʒ [postalveolar affricate voiced obstruent]

Symbol ʈ [retroflex stop voiceless obstruent]
Symbol ɖ [retroflex stop voiced obstruent]
Symbol ɳ [retroflex nasal voiced sonorant]
Symbol ɽ [retroflex tap voiced sonorant]

Symbol t̻ [prepalatal stop voiceless obstruent]
Symbol d̻ [prepalatal stop voiced obstruent]
???LINES MISSING
   * => ə/{{$, [!vowel]} [cons *syllabic !approximant]$1 _ [cons *syllabic !approximant], [cons *syllabic !approximant]$1 _ [cons *syllabic !approximant] {$, [!vowel]}}//$1 _ $1
   then:
   {[approximant], [nasal]}$1 => [+syllabic]/{$, [cons !approximant]} _ {$, [!approximant cons]}//{$1 _, _ $1}
   {[approximant], [nasal]} => [-syllabic]/{{!$, [!cons]} _, _ {!$, [!cons]}}

New-Stress-pattern @stressable:
[] => [-acute -grave]
then:
 ([+long] => [+acute]/_ $ #if final syllable(vowel) is long: it is stressed
 else:
  [] => [+acute]/_ [] $ #if not, penultimate vowel is stressed
  else:
   [] => [+acute]/$ _ #if not, antepenult is stressed, which is basically also the first syllable
 )
 then: [] => [+grave]/_ [] [+acute]

Turn89:
[-acute -grave vowel] => [-long]
then:
 [vowel] {ɰ, l}&[-syllabic] => [+long] */_ [cons]
 {ɰ, ɰ ɰ, l, l l} => ə//{[vowel], ., $} _ [vowel]
 then:
  {{ɰ, ɰ ɰ, l, l l}, {ɰ̩, l̩}} => {ɾ, ɾ̩}

Turn89-part2:
[stop] => ʔ/[vowel] _ {!@stressable, $}
[fricative] => h/[vowel] _ {!@stressable, $}
[affricate] * => [] ɪ/_ $
[alveolar fricative +long] => [affricate -long]/$ _
then:
 {ɑ ɛ, ɛ ɑ} => {ɑɪ, ɪɑ}
 {j, j̩} => ɪ//[vowel] _ [vowel]
 then:
   {m̩ɲ, mɲ} => məɲ/{$ _, _ $}

Stress-reapplied @stressable:
[] => [-acute -grave]
then:
 ([+long] => [+acute]/_ $ #if final syllable(vowel) is long: it is stressed
 else:
  [] => [+acute]/_ [] $ #if not, penultimate vowel is stressed
  else:
   [] => [+acute]/$ _ #if not, antepenult is stressed, which is basically also the first syllable
 )
 then: [] => [+grave]/_ [] [+acute]

Turn90:
[vowel $height $roundness $quality $frontness] => [+acute]/{[$height $roundness $quality $frontness +acute] _, _  [$height $roundness $quality $frontness +acute]}
[vowel $height $roundness $quality $frontness] => [+grave]/{[$height $roundness $quality $frontness +grave] _, _  [$height $roundness $quality $frontness +grave]}
then: [vowel]$1 $1 => [+long] *
then: [+long] => [-long]
then:
 {ɑɪ, ɑʊ, ʊɑ, əɑ, ɑə, ɑɛ} => ɑː
 {ɪɑ, ɛə, ɛɑ, ɛɪ, əɛ, ɪɛ, ʊɛ} => ɛː
 {ʏɑ, ʏɛ, ʏœ, œɑ, œɒ, œɛ, œə, œɪ, ʊi, ɑʏ, ɒʏ, ɛʏ, œʏ, ɛɒ, ɛœ, ɛʊ, əœ, ɪɒ, ɪœ, ʊœ} => œː
 {uɪ, ʊə, əʊ} => ʊː
 {əɪ, ɪə, ʊi} => ɪː
 {ɪu, iʊ, ʏʊ, əʏ, ɪʏ, ʊʏ, ʏə, ʏɪ, ɒʊ, œʊ} => yː
 {ɒə, ɒɑ, ɒɛ, ɒœ, ɒʊ, ɑɒ, ɑœ, əɒ, ʏɒ, ʊɒ} => ɒː
 then:
  [vowel]$1 $1 => [+long] *

Turn90-part2:
  * [+syllabic] => ə [-syllabic]
 then:
  ɾ * => [] ʊ/_ $
 then:
 [vowel] * [vowel] => [] j []

